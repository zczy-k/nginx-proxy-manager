# ─── NPM Systemd 服务参考 ──────────────────────────────────
# 此文件为配置参考，实际部署时由 setup.sh 动态生成到
# /etc/systemd/system/npm-backend.service
# 并自动代入自定义端口和路径。
#
# 后端端口修改: setup.sh 自动通过 sed 替换 index.js 中的 app.listen(3000)

[Unit]
Description=Nginx Proxy Manager Backend
Documentation=https://nginxproxymanager.com
After=network.target nginx.service
Wants=nginx.service

[Service]
Type=simple
User=npm
Group=npm
WorkingDirectory=/opt/nginx-proxy-manager/backend

# ─── 内存优化 (2C1G 服务器) ───
Environment=NODE_OPTIONS="--max-old-space-size=256"
Environment=NODE_ENV=production
Environment=DB_SQLITE_FILE=/data/npm/database.sqlite
Environment=DISABLE_IPV6=true
Environment=IP_RANGES_FETCH_ENABLED=false

ExecStart=/usr/bin/node index.js
ExecReload=/bin/kill -SIGTERM $MAINPID
Restart=on-failure
RestartSec=5

# ─── 安全隔离 ───
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
